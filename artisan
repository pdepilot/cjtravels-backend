#!/usr/bin/env php
<?php

/**
 * Travelbookings — Artisan CLI (Core PHP Edition)
 */

define('LARAVEL_START', microtime(true));

$app = require_once __DIR__ . '/bootstrap/app.php';

// Load routes for CLI introspection
require_once __DIR__ . '/routes/web.php';

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? 'list';

switch ($command) {
    case 'serve':
        $host = '127.0.0.1';
        $port = '8000';
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--host=')) {
                $host = substr($arg, 7);
            }
            if (str_starts_with($arg, '--port=')) {
                $port = substr($arg, 7);
            }
        }
        echo "\033[32m   INFO  Server running on [http://{$host}:{$port}].\033[0m\n\n";
        echo "  Press Ctrl+C to stop the server\n\n";
        passthru(sprintf('php -S %s:%s server.php', escapeshellarg($host), escapeshellarg($port)));
        break;

    case 'migrate':
        echo "\n\033[36mRunning database migrations...\033[0m\n";
        try {
            $migrator = new App\Core\Migrator();
            $ran = $migrator->run();
            if (empty($ran)) {
                echo "\033[32mNothing to migrate. Database is up to date.\033[0m\n\n";
            } else {
                foreach ($ran as $m) {
                    echo "  \033[32mMigrated:\033[0m {$m}\n";
                }
                echo "\n\033[32mAll migrations completed successfully.\033[0m\n\n";
            }
        } catch (\Exception $e) {
            echo "\033[31mMigration failed: " . $e->getMessage() . "\033[0m\n\n";
            exit(1);
        }
        break;

    case 'db:seed':
        echo "\n\033[36mSeeding initial travel management data...\033[0m\n";
        try {
            require_once __DIR__ . '/database/seeders/DatabaseSeeder.php';
            $res = Database\Seeders\DatabaseSeeder::run();
            echo "  \033[32mSeeded Users:\033[0m {$res['users']} records\n";
            echo "  \033[32mSeeded Flights:\033[0m {$res['flights']} records\n";
            echo "  \033[32mSeeded Hotels:\033[0m {$res['hotels']} records\n";
            echo "  \033[32mSeeded Loan Enquiries:\033[0m {$res['loans']} records\n";
            echo "  \033[32mSeeded Transactions:\033[0m {$res['transactions']} records\n\n";
            echo "\033[32mDatabase seeding completed successfully.\033[0m\n\n";
        } catch (\Exception $e) {
            echo "\033[31mSeeding failed: " . $e->getMessage() . "\033[0m\n\n";
            exit(1);
        }
        break;

    case 'admin:create':
        echo "\n\033[33m+-------------------------------------------------------------+\033[0m\n";
        echo "\033[33m|        CJ TRAVELS — INITIAL ADMINISTRATOR PROVISIONING      |\033[0m\n";
        echo "\033[33m+-------------------------------------------------------------+\033[0m\n\n";

        // Parse command line options
        $name = null;
        $email = null;
        $username = null;
        $password = null;
        $role = App\Models\Admin::ROLE_SUPER_ADMIN;

        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--name=')) $name = trim(substr($arg, 7), " '\"");
            if (str_starts_with($arg, '--email=')) $email = trim(substr($arg, 8), " '\"");
            if (str_starts_with($arg, '--username=')) $username = trim(substr($arg, 11), " '\"");
            if (str_starts_with($arg, '--password=')) $password = trim(substr($arg, 11), " '\"");
            if (str_starts_with($arg, '--role=')) $role = trim(substr($arg, 7), " '\"");
        }

        // Run migrations first to ensure table exists
        (new App\Core\Migrator())->run();

        // Check if interactive input is available and arguments are missing
        if (empty($name)) {
            echo "Enter Full Name [CJ Travels Director]: ";
            $input = trim(fgets(STDIN) ?: '');
            $name = $input ?: 'CJ Travels Director';
        }

        if (empty($email)) {
            echo "Enter Administrator Email [admin@cjtravels.com]: ";
            $input = trim(fgets(STDIN) ?: '');
            $email = $input ?: 'admin@cjtravels.com';
        }

        if (empty($username)) {
            $suggestedUsername = strtolower(preg_replace('/[^a-zA-Z0-9_]/', '', explode('@', $email)[0]));
            $username = $suggestedUsername;
        }

        if (empty($password)) {
            $password = bin2hex(random_bytes(4)) . '!Aa' . rand(10, 99);
        }

        // Validate
        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            echo "\033[31mError: Invalid email address [{$email}].\033[0m\n\n";
            exit(1);
        }

        if (strlen($password) < 8) {
            echo "\033[31mError: Password must be at least 8 characters long.\033[0m\n\n";
            exit(1);
        }

        // Check duplicate
        if (App\Models\Admin::findByEmail($email)) {
            echo "\033[31mError: An administrator account with email [{$email}] already exists!\033[0m\n\n";
            exit(1);
        }

        if (!empty($username) && App\Models\Admin::findByUsername($username)) {
            echo "\033[31mError: An administrator account with username [{$username}] already exists!\033[0m\n\n";
            exit(1);
        }

        $admin = App\Models\Admin::create([
            'name' => $name,
            'username' => $username,
            'email' => $email,
            'password' => $password,
            'role' => $role,
            'status' => App\Models\Admin::STATUS_ACTIVE,
        ]);

        echo "\033[32m✔ Administrator account created successfully!\033[0m\n\n";
        echo "  \033[1mID:\033[0m       {$admin->id}\n";
        echo "  \033[1mName:\033[0m     {$admin->name}\n";
        echo "  \033[1mUsername:\033[0m {$admin->username}\n";
        echo "  \033[1mEmail:\033[0m    {$admin->email}\n";
        echo "  \033[1mRole:\033[0m     {$admin->role}\n";
        echo "  \033[1mStatus:\033[0m   {$admin->status}\n";
        echo "  \033[1mPassword:\033[0m {$password}\n\n";
        echo "\033[36mYou can now sign in at: http://127.0.0.1:8000/admin/login\033[0m\n\n";
        break;

    case 'admin:list':
        $admins = App\Models\Admin::all();
        echo "\n\033[1;33m+----+-----------------------+--------------------+------------------------------+---------------------+----------+\033[0m\n";
        echo sprintf(
            "\033[1;37m| %-2s | %-21s | %-18s | %-28s | %-19s | %-8s |\033[0m\n",
            'ID', 'Name', 'Username', 'Email', 'Role', 'Status'
        );
        echo "\033[1;33m+----+-----------------------+--------------------+------------------------------+---------------------+----------+\033[0m\n";
        foreach ($admins as $a) {
            echo sprintf(
                "| %-2s | %-21s | %-18s | %-28s | %-19s | %-8s |\n",
                $a->id,
                mb_strimwidth($a->name, 0, 21),
                $a->username ?: '-',
                mb_strimwidth($a->email, 0, 28),
                mb_strimwidth($a->role, 0, 19),
                $a->status
            );
        }
        echo "\033[1;33m+----+-----------------------+--------------------+------------------------------+---------------------+----------+\033[0m\n\n";
        break;

    case 'test:auth':
        echo "\n\033[36m===============================================================\033[0m\n";
        echo "\033[36m   CJ TRAVELS — SECURITY TEST SUITE (MODULE 8)\033[0m\n";
        echo "\033[36m===============================================================\033[0m\n\n";

        $tester = new App\Core\SecurityTester();
        $results = $tester->runAll();

        $passedCount = 0;
        foreach ($results as $r) {
            $icon = $r['passed'] ? "\033[32m[PASS]\033[0m" : "\033[31m[FAIL]\033[0m";
            if ($r['passed']) $passedCount++;
            echo "  {$icon} \033[1m{$r['scenario']}\033[0m\n";
            echo "         \033[2m{$r['details']}\033[0m\n\n";
        }

        $total = count($results);
        echo "\033[36m---------------------------------------------------------------\033[0m\n";
        if ($passedCount === $total) {
            echo "\033[32m✔ SUCCESS: All {$total}/{$total} security scenarios PASSED completely.\033[0m\n\n";
        } else {
            echo "\033[31m✘ FAILED: {$passedCount}/{$total} scenarios passed.\033[0m\n\n";
            exit(1);
        }
        break;

    case 'route:list':
        $routes = App\Core\Router::getRoutes();
        echo "\n\033[1;33m+--------+---------------------------------------+-----------------------------+----------------------------------------------+\033[0m\n";
        echo sprintf(
            "\033[1;37m| %-6s | %-37s | %-27s | %-44s |\033[0m\n",
            'Method', 'URI', 'Name', 'Action'
        );
        echo "\033[1;33m+--------+---------------------------------------+-----------------------------+----------------------------------------------+\033[0m\n";

        foreach ($routes as $r) {
            $actionStr = '';
            if (is_array($r->action)) {
                $shortClass = basename(str_replace('\\', '/', $r->action[0]));
                $actionStr = $shortClass . '@' . $r->action[1];
            } elseif (is_string($r->action)) {
                $actionStr = $r->action;
            } else {
                $actionStr = 'Closure';
            }

            echo sprintf(
                "| \033[32m%-6s\033[0m | %-37s | \033[36m%-27s\033[0m | %-44s |\n",
                $r->method,
                $r->path,
                $r->name ?? '',
                $actionStr
            );
        }
        echo "\033[1;33m+--------+---------------------------------------+-----------------------------+----------------------------------------------+\033[0m\n\n";
        break;

    case '--version':
    case '-V':
        echo "Travelbookings Framework (Core PHP Laravel Architecture) 1.0.0\n";
        break;

    case 'list':
    default:
        echo "\n\033[32mTravelbookings Artisan (Core PHP Edition)\033[0m\n\n";
        echo "\033[33mUsage:\033[0m\n";
        echo "  php artisan <command> [options]\n\n";
        echo "\033[33mAvailable commands:\033[0m\n";
        echo "  \033[32mserve\033[0m          Serve the application on the PHP development server (default: 127.0.0.1:8000)\n";
        echo "  \033[32mmigrate\033[0m        Run all pending SQL database migrations\n";
        echo "  \033[32madmin:create\033[0m   Securely provision an administrator account (--name, --email, --password, --role)\n";
        echo "  \033[32madmin:list\033[0m     List registered administrator accounts\n";
        echo "  \033[32mtest:auth\033[0m      Run the 12-scenario administrator authentication security test suite\n";
        echo "  \033[32mroute:list\033[0m     List all registered application routes\n";
        echo "  \033[32m--version\033[0m      Display application framework version\n\n";
        break;
}
